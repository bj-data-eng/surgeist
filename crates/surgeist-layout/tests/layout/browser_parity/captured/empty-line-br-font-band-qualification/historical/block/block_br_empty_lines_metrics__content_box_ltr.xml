<test name="block_br_empty_lines_metrics__content_box_ltr" measurement-version="2" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="block" box-sizing="content-box" direction="ltr" font-size="20px" line-height="30px" width="120px">
      <div source-tag="br" display="inline" box-sizing="content-box" direction="ltr" font-size="20px" line-height="30px" inline-baseline="21px" inline-line-height="30px"/>
      <div source-tag="br" display="inline" box-sizing="content-box" direction="ltr" font-size="20px" line-height="30px" inline-baseline="21px" inline-line-height="30px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="120" height="60">
      <node>
        <browser-control source_index="0" terminal_visual_slot="0" previous_line="absent" next_line="later"/>
        <browser-br-font-band x="0" y="5" width="0" height="20"/>
      </node>
      <node>
        <browser-control source_index="1" terminal_visual_slot="0" previous_line="earlier" next_line="absent"/>
        <browser-br-font-band x="0" y="35" width="0" height="20"/>
      </node>
    </node>
  </expectations>
</test>
