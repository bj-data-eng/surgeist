# List available recipes.
default:
    @just --list

# Format Rust sources.
fmt:
    @./scripts/run-cargo-task.sh fmt

# Check Rust formatting without changing files.
fmt-check:
    @./scripts/run-cargo-task.sh fmt-check

# Check every target of the default configuration.
check:
    @./scripts/run-cargo-task.sh check

# Test the library and its doctests.
test:
    @./scripts/run-cargo-task.sh test

# Lint every target of the default configuration.
clippy:
    @./scripts/run-cargo-task.sh clippy

# Run all default verification checks.
verify:
    @./scripts/run-verification.sh default

# Check the browser-corpus feature configuration.
browser-check:
    @./scripts/run-cargo-task.sh browser-check

# Test the browser-corpus feature configuration.
browser-test:
    @./scripts/run-cargo-task.sh browser-test

# Lint the browser-corpus feature configuration.
browser-clippy:
    @./scripts/run-cargo-task.sh browser-clippy

# Run all browser-corpus verification checks.
verify-browser:
    @./scripts/run-verification.sh browser

# Run the full checked-in browser-parity corpus.
parity-all:
    @./scripts/run-browser-parity-task.sh parity-all

# Validate the checked-in browser-parity corpus.
corpus-check:
    @./scripts/run-browser-parity-task.sh corpus-check

# Validate the checked-in Taffy parity corpus.
taffy-check:
    @./scripts/run-browser-parity-task.sh taffy-check
